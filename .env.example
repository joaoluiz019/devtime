# Variáveis de ambiente do DevTime.
#
# RE-02 / ART-083: este arquivo contém apenas **nomes e descrições**. Nenhum valor real de segredo é
# versionado. Copie para `.env` e preencha os valores locais:
#
#   cp .env.example .env
#
# CF-03: a aplicação falha ao iniciar se qualquer variável obrigatória estiver ausente. A falha é
# proposital — subir com um segredo padrão é pior que não subir.

# ── Banco de dados ────────────────────────────────────────────────────────────────────────────
# Nome do banco criado pelo contêiner do PostgreSQL (ambiente local; em produção o banco é externo).
DEVTIME_DB_NAME=devtime
# Usuário da aplicação.
DEVTIME_DB_USERNAME=devtime
# Senha do usuário da aplicação. OBRIGATÓRIO. Use um valor local próprio, nunca em produção.
DEVTIME_DB_PASSWORD=
# Porta exposta no host pelo contêiner do banco (só o override `docker-compose.local.yml`).
DEVTIME_DB_PORT=5432
# URL JDBC do banco. OBRIGATÓRIO no deploy: é assim que o backend encontra o PostgreSQL externo.
# O override local sobrescreve este valor para o contêiner; aqui vale o backend rodando fora do
# Compose (ex.: pela IDE).
DEVTIME_DB_URL=jdbc:postgresql://localhost:5432/devtime
# Tamanho do pool de conexões.
DEVTIME_DB_POOL_SIZE=10

# ── Autenticação ──────────────────────────────────────────────────────────────────────────────
# Segredo HMAC do access token. OBRIGATÓRIO.
# TK-01 exige no mínimo 256 bits, ou seja, ao menos 32 caracteres. A aplicação recusa iniciar com um
# valor menor — inclusive se este campo receber o comando abaixo em vez da saída dele.
#
# Execute e cole o resultado:
#   openssl rand -base64 48
# Sem openssl (Windows):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
DEVTIME_JWT_SECRET=
# Claim `iss`, validada na verificação do token (security.md §5.2).
DEVTIME_JWT_ISSUER=https://api.devtime.local
# Claim `aud`, validada na verificação do token.
DEVTIME_JWT_AUDIENCE=devtime-web

# ── Aplicação ─────────────────────────────────────────────────────────────────────────────────
# Perfil ativo: local | test | staging | prod (backend.md §13.1).
# O perfil `scheduler` habilita os jobs agendados (JB-07).
DEVTIME_PROFILE=local
# Porta HTTP do backend.
DEVTIME_SERVER_PORT=8080
# Porta do frontend servido por nginx no Docker Compose.
DEVTIME_WEB_PORT=4200
# Origens permitidas em CORS, separadas por vírgula (security.md §8.3).
# Nunca use `*`: o cookie de refresh exige allowCredentials, e a combinação é rejeitada.
#
# Precisa conter o domínio do **frontend**, mesmo quando ele chama a API por caminho relativo. O
# proxy que dá a mesma origem ao navegador (rewrite da Vercel, bloco `/api` do nginx) encaminha o
# `Origin` original enquanto reescreve o `Host` para o domínio da API — o Spring compara os dois e
# trata a requisição como cross-origin. Ausente daqui, o domínio recebe `403 Invalid CORS request`
# em toda chamada feita pelo navegador, inclusive no preflight e no login, enquanto as mesmas rotas
# respondem normalmente a um cliente que não envia `Origin` (curl, testes de integração).
DEVTIME_CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── E-mail transacional (integrations.md §6.1 e §12) ──────────────────────────────────────────
# Base dos links enviados por e-mail (verificação, redefinição, convite). OBRIGATÓRIA.
# Vem de configuração e nunca do header Host da requisição: derivá-la da requisição permitiria a um
# atacante fazer o sistema enviar, ao titular real, um link apontando para o domínio dele.
APP_BASE_URL=http://localhost:4200
# Remetente das mensagens transacionais. OBRIGATÓRIA.
# Com MAIL_PROVIDER=resend o domínio precisa estar verificado na conta do Resend; sem verificação
# apenas `onboarding@resend.dev` é aceito, e só para o e-mail dono da conta.
MAIL_FROM=nao-responda@devtime.local
# Provedor do adapter de e-mail em staging e prod: smtp | resend (integrations.md §6.1).
# Em local e test o LoggingMailAdapter atende MailPort e este valor é ignorado (BR-203).
MAIL_PROVIDER=smtp
# Chave da API do Resend. OBRIGATÓRIA quando MAIL_PROVIDER=resend — a aplicação recusa iniciar sem
# ela (CF-03). Gere em https://resend.com/api-keys; o valor começa com `re_`.
# Nunca versione a chave real: preencha somente no seu `.env` ou no cofre do ambiente.
RESEND_API_KEY=
# SMTP com TLS. Consumido apenas pelo SmtpMailAdapter, ativo em `staging` e `prod`; em `local` e
# `test` o LoggingMailAdapter registra o envio sem abrir conexão (BR-203).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Desligue a autenticação apenas em captura local de e-mail (Mailpit, MailHog).
MAIL_SMTP_AUTH=false

# ── Object storage (integrations.md §6.2 e §12) ───────────────────────────────────────────────
# Endpoint compatível com S3. No Docker Compose o MinIO responde em `http://minio:9000`; rodando o
# backend fora do Compose (pela IDE), use `http://localhost:9000`.
STORAGE_ENDPOINT=http://localhost:9000
# Bucket dos anexos. SG-01: **sempre privado**. A aplicação bloqueia o acesso público na
# inicialização (StorageBucketInitializer) e habilita versionamento com retenção de 30 dias (SG-03).
STORAGE_BUCKET=devtime-attachments
# Região exigida pelo SDK. O MinIO a ignora, mas o cliente recusa iniciar sem valor.
STORAGE_REGION=us-east-1
# Credenciais do storage. OBRIGATÓRIAS. Também usadas pelo contêiner do MinIO no Compose.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Porta do console web do MinIO no ambiente local (não usada pela aplicação).
STORAGE_CONSOLE_PORT=9001

# ── Antivírus (integrations.md §6.3 e §12) ────────────────────────────────────────────────────
# ClamAV. RS-03: dependência **obrigatória** — sem ela nenhum download de anexo é liberado
# (RN-803). Não existe variável para desligar a verificação: um interruptor de "pular verificação"
# seria o caminho de liberação manual que CP-02 proíbe, apenas com outro nome.
# No Docker Compose use `clamav`; fora dele, `localhost`.
ANTIVIRUS_HOST=localhost
ANTIVIRUS_PORT=3310
