{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/devtime-frontend/browser/pt-BR",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.devtime.cellentia.com.br/api/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "https://api.devtime.cellentia.com.br/actuator/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff|woff2|png|jpg|jpeg|svg|ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
